{
  "name": "codegraph-cf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup":          "node scripts/setup.mjs",
    "add-repo":       "node scripts/add-repo.mjs",
    "configure-mcp":  "node scripts/configure-mcp.mjs",
    "dev":            "wrangler dev",
    "deploy":         "wrangler deploy",
    "db:init":        "wrangler d1 execute codegraph --file=schema.sql",
    "db:init:remote": "wrangler d1 execute codegraph --remote --file=schema.sql",
    "typecheck":      "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
